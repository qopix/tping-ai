# Имя результирующего бинарника ИИ-агента
BINARY_NAME=tping-ai

.PHONY: all build clean run help

# По умолчанию запускается сборка проекта
all: build

# Компиляция всех Go-файлов в один исполняемый файл
build:
	@echo "📦 Сборка автономного ИИ-агента $(BINARY_NAME)..."
	go build -o $(BINARY_NAME) .
	@echo "✅ Сборка успешно завершена! Исполняемый файл: ./$(BINARY_NAME)"

# Очистка рабочего пространства от бинарника и временных файлов ИИ
clean:
	@echo "🧹 Очистка временных файлов..."
	rm -f $(BINARY_NAME)
	rm -rf ./agent_workspace
	@echo "✨ Папка очищена."

# Быстрая сборка и запуск агента одной командой
run: build
	@echo "🤖 Запуск ИИ-агента..."
	./$(BINARY_NAME)

# Справка по доступным командам
help:
	@echo "Доступные команды в Makefile:"
	@echo "  make         - Скомпилировать проект (по умолчанию)"
	@echo "  make build   - Скомпилировать проект"
	@echo "  make run     - Скомпилировать и сразу запустить ИИ-агента"
	@echo "  make clean   - Удалить бинарник и очистить скачанные репозитории"
